---
import { getCollection } from 'astro:content';
import Card from '../components/Card.astro';

const projects = await getCollection('projects');
---

<section class="w-[1600] max-w-[calc(100%-2rem)] md:mx-8 max-md:m-auto">
    <ul role="list" class="grid items-center grid-cols-[repeat(3,minmax(24ch,1fr))] gap-8 p-0 max-[1230px]:grid-cols-[repeat(1,minmax(24ch,1fr))]">
        {
            projects.map((project) => {
                const {title, description, image, category, href} = project.data;
                return <Card title={title} body={description} image={image} category={category} href={href} id={project.id}/>
            })
        }
    </ul>
</section>