---
export interface Props {
    chip_style: string;
    chip_label: string;
}

const { chip_style, chip_label } = Astro.props;
---

<div id="chip" class="mt-[24px] w-[fit-content] min-w-[32px] h-[16px] px-[16px] py-[16px] bg-[rgb(185,74,74)] rounded-[24px] flex items-center" style={chip_style}>
    {chip_label}
</div>