---
import Socials from "./Socials.astro"
---

<section id="aboutme">
    <div class="w800">
        <p>
            I'm an IT student based in Italy. 
            <br>I'm currently focusing on Web Development with Astro/TypeScript 
            and Android App Development with Kotlin.
            Besides that, I am a self taught UI Designer using Figma and PenPot
        </p>

        <p>
            Languages I know include: 
            TypeScript, JavaScript, Java, Python, GDScript, Kotlin and Dart.
        </p>

        <p>
            To know more, please check my GitHub profile
        </p>

        <Socials
            title="github"
            href="https://github.com/ImJustCri"
            icon="bx bxl-github"
            name= "GitHub"
        />
    </div>
</section>

<style>
    #aboutme {
        background-repeat: no-repeat;
        padding: 0 16px;
        color: #868c96;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        min-height: 300px;
        max-height: 1200px;
        margin-bottom: 64px;
    }

    .w800 {
        width: 800px;
        max-width: 800px;
        margin: auto;
    }

    #grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
    }

p {
    margin: 40px 0;
    text-align: left;
    font-size: 24px;
}

#left {
    max-width: 800px;
    margin: 0 64px;
}

#right {
    max-width: 800px;
    margin: 0 64px;
}

@media screen and (max-width: 1230px) {
    #flex {
        gap: 8px;
    }

    #grid {
        grid-template-columns: repeat(auto-fit, minmax(32ch, 1fr));
    }

    p {
        margin: 24px 0;
    }

    footer {
        padding: 32px 24px 80px 24px;
    }

    .w800 {
        width: auto;
        max-width: 100vw;
        margin: auto;
    }
}

</style>