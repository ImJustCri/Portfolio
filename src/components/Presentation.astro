---
import { Picture } from 'astro:assets';
import { LOGO, SHORT_DESCRIPTION, NAME } from '../config/config';
import Socials from '../components/Socials.astro';
---

<div class="m-auto text-center">
    <Picture
            src={LOGO}
            alt="logo"
            width={104}
            height={104}
            class="w-[104px] h-auto mt-10 rounded-full"
            loading="eager"
            fetchpriority="high"
            formats={['avif', 'webp']}
            fallbackFormat="png"
    />
</div>

<h1 class="text-[clamp(2.369rem,3vw+1rem,3.157rem)] font-semibold leading-none text-center mb-0 mt-4 text-gradient">{NAME}</h1>

<p class="text-center text-xl">
    {SHORT_DESCRIPTION}
</p>

<div class="flex justify-center items-center gap-3 mx-auto mt-8 mb-32 max-[1230px]:flex-col">
    <div style="display: flex; gap: 12px">
        <Socials
            title="github"
            href="https://github.com/ImJustCri"
            icon="bx bxl-github"
            name= "GitHub"
        />

        <Socials
            title="figma"
            href="https://www.figma.com/@imcri"
            icon="bx bxl-figma"
            name= "Figma"
        />				
    </div>

    <Socials
        title="website source code"
        href="https://github.com/ImJustCri/Portfolio"
        icon="bx bx-git-repo-forked"
        name= "Website Source Code"
    />
</div>

<style>
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0;
	}
</style>