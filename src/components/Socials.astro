---
interface Props {
	title: string;
    href: string;
    icon: string;
    name: string;
}

const { title, href, icon, name } = Astro.props;
---
<a href={href}>
    <div class="socials" id={title}>
        <i class= {icon}></i>
        <p>{name}</p>
    </div>
</a>

<style>

    * {
		cursor: none;
	}

    .socials {
        width: fit-content;
        display: flex;
        height: fit-content;
        background-color: #23262d;
        border-radius: 7px;
        padding: 0px 16px;
		background-position: 100%;
		transition: 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        text-align: center;
        justify-content: center;
        align-items: center;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
        background-size: 400%;
        gap: 8px;
        
    }

    .socials:is(:hover, :focus-within) {
		background-position: 0;
		background-image: var(--accent-gradient);
		transform: scale(1.1);
	}

    a {
		text-decoration: none;
        color: white;
        font-size: 32px;
	}

    p {
        font-size: 16px;
    }
</style>