---
import { PROJECTS } from "../config/config";
import Chip from "./Chip.astro";
import { Picture } from 'astro:assets';

interface Props {
	i: number;
}

const { i } = Astro.props;
---

<li class="link-card">
	
	<a href= {PROJECTS[i].projectHref} class="w-full no-underline leading-[1.4] p-[8px] rounded-[24px] text-white bg-[#23262d] opacity-[0.8]">
		<!--<img src={PROJECTS[i].imagePath} alt="" class="w-full h-auto rounded-[16px] mb-[32px]">-->
        <Picture
                src={PROJECTS[i].imagePath}
                alt=""
                width={50}
                height={50}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                class="w-full h-auto rounded-[16px] mb-[32px]"
                loading="eager"
        />

        <div class="m-0 mx-[16px] mb-[32px]">
			<h2 class="m-0 text-[1.35rem] transition-colors duration-600 ease-[cubic-bezier(0.22,1,0.36,1)]">
				{PROJECTS[i].title}
			</h2>
			<p class="mt-[8px] text-[#9ba7b9] mb-0">
				{PROJECTS[i].body}
			</p>

			<Chip
				chip_label= {PROJECTS[i].chip_label}
				chip_style={PROJECTS[i].chip_style}
			/>
		</div>
	</a>

</li>
<style>
	.link-card {
		list-style: none;
		display: flex;
		background-color: #23262d0;
		background-image: none;
		background-size: 400%;
		border-radius: 7px;
		background-position: 100%;
		transition: 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
	}

	.link-card:is(:hover, :focus-within) {
		background-position: 0;
		background-image: var(--accent-gradient);
		transform: scale(1.01);
	}

	.link-card:active {
		transform: scale(0.98);
	}

	.link-card:is(:hover, :focus-within) h2 {
		color: rgb(var(--accent-light));
	}
</style>
