---
import { PROJECTS } from "../config/config";

interface Props {
	i: number;
}

const { i } = Astro.props;
---

<li class="link-card">
	
	<a href= {PROJECTS[i].projectHref}>
		<img src={PROJECTS[i].imagePath} alt="" class="projectImage">
		<div class="content">
			<h2>
				{PROJECTS[i].title}
			</h2>
			<p>
				{PROJECTS[i].body}
			</p>

			<div id="chip" style={PROJECTS[i].chip_style}>
				{PROJECTS[i].chip_label}
			</div>
		</div>
	</a>

</li>
<style>

	.link-card {
		list-style: none;
		display: flex;
		background-color: #23262d0;
		background-image: none;
		background-size: 400%;
		border-radius: 7px;
		background-position: 100%;
		transition: 0.6s cubic-bezier(0.22, 1, 0.36, 1);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
	}
	.link-card > a {
		width: 100%;
		text-decoration: none;
		line-height: 1.4;
		padding: 8px;
		border-radius: 8px;
		color: white;
		background-color: #23262d;
		opacity: 0.8;
	}

	h2 {
		margin: 0;
		font-size: 1.35rem;
		transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}
	p {
		margin-top: 0.5rem;
		color: #9ba7b9;
		margin-bottom: 0;
	}
	.link-card:is(:hover, :focus-within) {
		background-position: 0;
		background-image: var(--accent-gradient);
		transform: scale(1.01);
	}

	.link-card:active {
		transform: scale(0.98);
	}

	.link-card:is(:hover, :focus-within) h2 {
		color: rgb(var(--accent-light));
	}

	.projectImage {
		width: 100%;
		height: auto;
		border-radius: 4px;
		margin-bottom: 32px;
	}

	.content {
		margin: 0 16px 32px 16px;
	}

	#chip {
		margin-top: 24px;
		width: fit-content;
		min-width: 32px;
		height: 16px;
		padding: 16px 16px;
		background: rgb(185, 74, 74);
		border-radius: 24px;
		display: flex;
		align-items: center;
	}
</style>
