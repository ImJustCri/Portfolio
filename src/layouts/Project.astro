---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Chip from '../components/Chip.astro';
import { PROJECTS } from '../config/config';
import { Image } from 'astro:assets';

const { frontmatter } = Astro.props;
---

<Layout title= { frontmatter.title }>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <NavBar/>

    <div id="projectDiv">
        <h1>{ frontmatter.title }</h1>

        <div id="chipDiv">
            <Chip
			    chip_label= {PROJECTS[frontmatter.i].chip_label}
			    chip_style={PROJECTS[frontmatter.i].chip_style}
		    />
        </div>

        <div id="textDiv">
            <div id="imageDiv">
                <Image
                        src={frontmatter.image}
                        alt="project"
                        width=50
                        height=50
                        class=" w-full h-auto rounded-[16px]"
                        loading="eager"
                />
            </div>

            <p>
                <slot/>
            </p>

            <a href= { frontmatter.href }>
                <div id="projectLink">
                    Check out this project
                </div>
            </a>
        </div>
    </div>

</Layout>

<style>
    html {
		/* background-color: var(--bg); */
        background-image: url(/pattern.png);
		animation: appear 500ms ease-in;
	}

    * {
        color: white;
    }

    h1 {
        text-align: center;
        font-size: 32px;
        margin: 96px 0 32px 0;
    }

    #chipDiv {
        max-width: fit-content;
        margin: auto auto 32px;
    }

    p {
        margin: 40px 0;
        text-align: left;
        font-size: 24px;
        color: white;
    }

    #projectDiv {
        margin: auto;
        max-width: 1200px;
    }

    Content > a {
        text-decoration: none;
    }

    #imageDiv {
        width: auto;
        margin: auto;
    }

    #projectImage {
        width: 100%;
        border-radius: 16px;
    }

    #textDiv {
        max-width: 800px;
        margin: 64px auto auto;
    }

    #projectLink {
        margin: 32px 0;
        width: fit-content;
        padding: 16px;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        background: #23262d7c 100%;
        transition: 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        background-size: 400%;
    }

    a {
        text-decoration: none;
    }

    #projectLink:is(:hover, :focus-within) {
		background-position: 0;
		background-image: var(--accent-gradient);
		transform: scale(1.05);
	}


    @keyframes appear {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

    @media screen and (max-width: 840px) {
        #textDiv {
            margin: auto 24px;
        }
    }
</style>