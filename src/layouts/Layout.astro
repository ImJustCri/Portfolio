---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="ImJustCri" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="Portfolio/public/favicon.ico">
		<link rel="stylesheet" href="Portfolio/src/stylesheets/style.css">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<script src="https://unpkg.com/boxicons@2.1.4/dist/boxicons.js"></script>
