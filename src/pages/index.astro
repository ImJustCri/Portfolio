---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Presentation from '../components/Presentation.astro';
---

<Layout title="ImJustCri | Home">
    <NavBar/>
	
	<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

	<main class="mx-auto w-[1800px] max-w-[calc(100%-2rem)] text-white text-[20px] leading-[1.6] relative z-1 max-h-screen">
		<div class="flex justify-center items-center h-[82vh]">
			<div class="presentationDiv">
				<Presentation></Presentation>
			</div>
		</div>
	</main>
</Layout>