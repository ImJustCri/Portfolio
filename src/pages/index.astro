---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import NavBar from '../components/NavBar.astro';
import Presentation from '../components/Presentation.astro';
---

<Layout title="ImJustCri | Home">
	<link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

	<NavBar></NavBar>

	<main>
		<div class="centeredDiv">
			<div class="presentationDiv">
				<Presentation></Presentation>
			</div>
		</div>
	</main>
</Layout>

<style>

	html {
		background-color: var(--bg);
		animation: appear 500ms ease-in;
	}

	@keyframes appear {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes scale {
		from {
			transform: scale(1.01);
		}
		to {
			transform: scale(1);
		}
	}

	.logo_div {
		margin: auto;
		text-align: center;
	}
	
	main {
		margin: auto;
		width: 1800px;
		max-width: calc(100% - 2rem);
		color: white;
		font-size: 20px;
		line-height: 1.6;
		position: relative;
  		z-index: 1;
  		max-height: 100vh;
	}

	h1 {
		font-size: clamp(2.369rem, 3vw + 1rem, 3.157rem);
		font-weight: 600;
		line-height: 1;
		text-align: center;
		margin-bottom: 0;
		margin-top: 16px;
	}

	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
	
	.instructions {
		margin-bottom: 2rem;
		border: 1px solid rgba(var(--accent-light), 25%);
		background: linear-gradient(rgba(var(--accent-dark), 66%), rgba(var(--accent-dark), 33%));
		padding: 1.5rem;
		border-radius: 8px;
	}

	.link-card-grid {
		display: grid;
		align-items: center;
		grid-template-columns: repeat(3, minmax(24ch, 1fr));
		gap: 2rem;
		padding: 0;
		animation: scale 1000ms ease-in;
	}

	.about_me {
		text-align: center;
		font-size: 1.25rem;
	}

	.socials {
		display: flex;
		height: 85vh;
		justify-content: center;
		justify-items: center;
		align-items: center;
	}
</style>
